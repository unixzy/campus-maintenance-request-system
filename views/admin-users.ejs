<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Manage Users - Campus Maintenance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-dark bg-primary px-3">
    <a class="navbar-brand" href="/dashboard">Campus Maintenance</a>
    <form method="POST" action="/logout" class="d-flex align-items-center gap-3 m-0">
      <span class="text-white"><%= user.name %> (<%= user.role %>)</span>
      <button class="btn btn-light btn-sm" type="submit">Log out</button>
    </form>
  </nav>

  <main class="container mt-4">
    <h1 class="h4 mb-3">Manage Users</h1>

    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>

    <div class="card mb-4">
      <div class="card-body">
        <h2 class="h6">Create a technician account</h2>
        <form method="POST" action="/admin/users" class="row g-3">
          <div class="col-md-3">
            <label for="name" class="form-label">Full name</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= form.name %>" required>
          </div>
          <div class="col-md-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="<%= form.email %>" required>
          </div>
          <div class="col-md-3">
            <label for="specialty" class="form-label">Specialty (optional)</label>
            <input type="text" class="form-control" id="specialty" name="specialty" value="<%= form.specialty %>" maxlength="50">
          </div>
          <div class="col-md-3">
            <label for="password" class="form-label">Temporary password</label>
            <input type="password" class="form-control" id="password" name="password" required>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-primary">Create technician</button>
          </div>
        </form>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Role</th><th>Specialty</th><th>Status</th><th>Action</th></tr>
        </thead>
        <tbody>
          <% users.forEach(function (u) { %>
            <tr>
              <td><%= u.name %></td>
              <td><%= u.email %></td>
              <td><%= u.role %></td>
              <td><%= u.specialty || '-' %></td>
              <td>
                <span class="badge <%= u.is_active === 1 ? 'bg-success' : 'bg-secondary' %>">
                  <%= u.is_active === 1 ? 'Active' : 'Deactivated' %>
                </span>
              </td>
              <td>
                <% if (u.id !== user.id) { %>
                  <form method="POST" action="/admin/users/<%= u.id %>/toggle" class="m-0">
                    <button type="submit" class="btn btn-sm <%= u.is_active === 1 ? 'btn-outline-danger' : 'btn-outline-success' %>">
                      <%= u.is_active === 1 ? 'Deactivate' : 'Reactivate' %>
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-muted">You</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>