<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard - Campus Maintenance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-dark bg-primary px-3">
    <span class="navbar-brand">Campus Maintenance</span>
    <form method="POST" action="/logout" class="d-flex align-items-center gap-3 m-0">
      <span class="text-white"><%= user.name %> (<%= user.role %>)</span>
      <button class="btn btn-light btn-sm" type="submit">Log out</button>
    </form>
  </nav>
  <main class="container mt-4">
    <h1 class="h4">Welcome, <%= user.name %></h1>
    <% if (user.role === 'requester') { %>
      <p>You can submit maintenance requests and track their status.</p>
    <% } else if (user.role === 'technician') { %>
      <p>You can view your assigned jobs and update their status.</p>
      <% if (typeof locals.isAvailable !== 'undefined') { %>
        <form method="POST" action="/technician/availability" class="d-flex align-items-center gap-2">
          <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:<%= locals.isAvailable ? '#198754' : '#6c757d' %>;"></span>
          <div class="form-check form-switch m-0">
            <input class="form-check-input" type="checkbox" role="switch" id="availability"
                   <%= locals.isAvailable ? 'checked' : '' %> onchange="this.form.submit()">
            <label class="form-check-label" for="availability">
              <%= locals.isAvailable ? 'Available' : 'Not available' %>
            </label>
          </div>
        </form>
      <% } %>
    <% } else if (user.role === 'admin') { %>
      <p>You can assign requests, manage users, and view reports.</p>
    <% } %>
  </main>
</body>
</html>