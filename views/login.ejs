<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login - Campus Maintenance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container" style="max-width: 420px; margin-top: 10vh;">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3">Campus Maintenance Request System</h1>
        <% if (error) { %>
          <div class="alert alert-danger" role="alert"><%= error %></div>
        <% } %>
        <form method="POST" action="/login">
        <div class="mb-3">
            <label for="role" class="form-label">Log in as</label>
                <select class="form-select" id="role" name="role" required>
                    <option value="requester">Requester (student / faculty / staff)</option>
                    <option value="technician">Technician</option>
                    <option value="admin">Administrator</option>
                </select>
            </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="<%= email %>" required>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>